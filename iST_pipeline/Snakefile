# Default target: binned objects for all platforms and resolutions
rule all:
    input:
        expand(
            "results/01_preprocessing/xenium_{resolution}um/{sample}_{resolution}um.rds",
            sample     = config["xenium"]["samples"],
            resolution = config["bin_resolutions"],
        ),
        expand(
            "results/01_preprocessing/merscope_{resolution}um/{sample}_{resolution}um.rds",
            sample     = config["merscope"]["samples"],
            resolution = config["bin_resolutions"],
        ),


# 01_preprocessing targets, one per platform x method (e.g. snakemake xenium_binning).
# *_binning_filtered adds post-filter QC. Override binning resolution with
#   snakemake --config bin_resolutions=[8]

rule xenium_binning:
    input:
        expand(
            "results/01_preprocessing/xenium_{resolution}um/{sample}_{resolution}um.rds",
            sample     = config["xenium"]["samples"],
            resolution = config["bin_resolutions"],
        )


rule merscope_binning:
    input:
        expand(
            "results/01_preprocessing/merscope_{resolution}um/{sample}_{resolution}um.rds",
            sample     = config["merscope"]["samples"],
            resolution = config["bin_resolutions"],
        )


rule xenium_binning_filtered:
    input:
        expand(
            "results/01_preprocessing/xenium_{resolution}um_filtered/{sample}_{resolution}um_filtered.rds",
            sample     = config["xenium"]["samples"],
            resolution = config["bin_resolutions"],
        ),
        expand(
            "results/01_preprocessing/xenium_{resolution}um_filtered/filter_qc_all.pdf",
            resolution = config["bin_resolutions"],
        )


rule merscope_binning_filtered:
    input:
        expand(
            "results/01_preprocessing/merscope_{resolution}um_filtered/{sample}_{resolution}um_filtered.rds",
            sample     = config["merscope"]["samples"],
            resolution = config["bin_resolutions"],
        ),
        expand(
            "results/01_preprocessing/merscope_{resolution}um_filtered/filter_qc_all.pdf",
            resolution = config["bin_resolutions"],
        )


# STalign registration: only the 4 matched samples per platform
# (config["stalign"]["matched_samples"]). 16um targets are separate so 16um can
# be brought online independently of 8um.
rule xenium_binning_aligned:
    input:
        expand(
            "results/01_preprocessing/xenium_8um_aligned/{sample}_8um_aligned.rds",
            sample = config["stalign"]["matched_samples"]["xenium"].values(),
        )


rule merscope_binning_aligned:
    input:
        expand(
            "results/01_preprocessing/merscope_8um_aligned/{sample}_8um_aligned.rds",
            sample = config["stalign"]["matched_samples"]["merscope"].values(),
        )


rule xenium_binning_aligned_16um:
    input:
        expand(
            "results/01_preprocessing/xenium_16um_aligned/{sample}_16um_aligned.rds",
            sample = config["stalign"]["matched_samples"]["xenium"].values(),
        )


rule merscope_binning_aligned_16um:
    input:
        expand(
            "results/01_preprocessing/merscope_16um_aligned/{sample}_16um_aligned.rds",
            sample = config["stalign"]["matched_samples"]["merscope"].values(),
        )


